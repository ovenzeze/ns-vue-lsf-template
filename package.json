{
  "name": "ns-vue-lsf-template",
  "description": "NativeScript Vue LSF Template - A production-ready starter template inspired by shadcn/ui",
  "main": "src/app.ts",
  "version": "1.0.0",
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ns-vue-lsf-template"
  },
  "scripts": {
    "android:build": "bun run ns build android",
    "android:release": "bun run ns build android --release --key-store-path \"$ANDROID_KEYSTORE_PATH\" --key-store-password \"$ANDROID_KEYSTORE_PASSWORD\" --key-store-alias \"$ANDROID_KEYSTORE_ALIAS\" --key-store-alias-password \"$ANDROID_KEYSTORE_ALIAS_PASSWORD\"",
    "android:bundle": "bun run ns build android --release --aab --key-store-path \"$ANDROID_KEYSTORE_PATH\" --key-store-password \"$ANDROID_KEYSTORE_PASSWORD\" --key-store-alias \"$ANDROID_KEYSTORE_ALIAS\" --key-store-alias-password \"$ANDROID_KEYSTORE_ALIAS_PASSWORD\"",
    "ios:build:dev": "bun run ns build ios",
    "ios:build": "bun run ns build ios --release --for-device",
    "ios:sign": "fastlane ios prepare_signing",
    "ios:uuid": "bun scripts/ios-uuid.ts appstore",
    "ios:build:appstore": "UUID=$(npm run -s ios:uuid) && bun run ns build ios --release --for-device --provision \"$UUID\"",
    "ios:validate": "bash scripts/validate-ipa.sh",
    "ios:check-consistency": "bash scripts/check-ipa-consistency.sh",
    "ios:version-info": "bash scripts/fix-info-plist.sh",
    "ios:version-bump": "bash scripts/fix-info-plist.sh bump",
    "ios:upload": "fastlane ios upload_only",
    "ios:release": "fastlane ios release",
    "ios:info": "fastlane ios info",
    "preflight:ios": "bash scripts/preflight-check.sh",
    "clean": "bun run ns clean"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@nativescript-community/ui-material-bottomsheet": "^7.2.78",
    "@nativescript/core": "~8.9.1",
    "marked": "^15.0.7",
    "nativescript-vue": "3.0.1",
    "readable-stream": "^4.7.0",
    "url": "^0.11.4",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@csstools/postcss-is-pseudo-class": "^5.0.3",
    "@nativescript/ios": "8.9.4",
    "@nativescript/preview-cli": "^1.0.14",
    "@nativescript/stackblitz": "^0.0.8",
    "@nativescript/tailwind": "~4.0.3",
    "@nativescript/types": "~8.9.1",
    "@nativescript/webpack": "~5.0.24",
    "@types/node": "^24.8.1",
    "nativescript": "^8.9.3",
    "tailwindcss": "^4.1.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3"
  },
  "packageManager": "bun@1.3.0"
}
