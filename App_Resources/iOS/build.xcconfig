// You can add custom settings here
// for example you can uncomment the following line to force distribution code signing
CODE_SIGN_IDENTITY = Apple Distribution
// To build for device with XCode you need to specify your development team.
DEVELOPMENT_TEAM = ZWR64GCC4R;
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon;

// Version settings
CURRENT_PROJECT_VERSION = 6
MARKETING_VERSION = 1.0

// Force use our Info.plist
INFOPLIST_FILE = $(SRCROOT)/App_Resources/iOS/Info.plist

### BEGIN FASTLANE SIGNING ###
// Managed by Fastlane lanes. Do not edit between markers.
DEVELOPMENT_TEAM = ZWR64GCC4R;
CODE_SIGN_STYLE = Manual;
CODE_SIGN_IDENTITY = Apple Distribution;
PROVISIONING_PROFILE_SPECIFIER = match AppStore com.ovenzeze.nsvuestarter;
IPHONEOS_DEPLOYMENT_TARGET = 13.0;
// iPhone only (prevents iPad requirement)
TARGETED_DEVICE_FAMILY = 1;
### END FASTLANE SIGNING ###
